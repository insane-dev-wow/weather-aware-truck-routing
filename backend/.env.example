# Copy to backend/.env and adjust as needed. All values below are optional —
# the app runs with zero API keys out of the box.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_ALL=False
# Production: exact frontend origin(s), comma separated; no trailing slashes.
# Must be the UI origin, not the API host.
CORS_ALLOWED_ORIGINS=https://weather-aware-truck-routing-tulv.vercel.app

DJANGO_BEHIND_PROXY=False
# On Vercel, also set:
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=weather-aware-truck-routing-green.vercel.app,.vercel.app
# Settings also auto-add VERCEL_URL / .vercel.app when Vercel env vars are present.
# Optional PostgreSQL; SQLite is the local/demo default.
# DATABASE_URL=postgresql://user:password@host:5432/database
# On Vercel, SQLite defaults to /tmp/wayline/ (writable). Prefer Postgres for persistence.

# Upstream data providers (key-free defaults).
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
ROUTING_CLIENT_ID=wayline-assessment-local
# Optional legacy provider: set ROUTING_PROVIDER=osrm.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Search-as-you-type suggestions use Photon, not public Nominatim.
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Identify your deployment to the public geocoder. Include a contact address.
GEOCODER_USER_AGENT=weather-truck-routing/1.0 (assessment demo)
# Public Nominatim permits explicit searches, not autocomplete. Keep a single
# deployment instance. All local workers share the SQLite request throttle.
# Policy: https://operations.osmfoundation.org/policies/nominatim/
# GEOCODER_RATE_LIMIT_DB=/writable/path/geocoder-rate-limit.sqlite3

# Tuning for the weather fan-out.
WEATHER_CHUNK_SIZE=50
WEATHER_MAX_WORKERS=2
HEATMAP_MAX_CELLS=240
UPSTREAM_TIMEOUT=10
ROUTING_TIMEOUT=15
